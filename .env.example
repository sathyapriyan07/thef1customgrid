# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and anon/publishable key.
# When provided, all reads and writes sync with your live Supabase PostgreSQL backend.
# If left empty, the application uses local reactive persistence so you can test all features immediately.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
